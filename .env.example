# EventEdge gen_003 LLM configuration:
# Default billing mode is chatgpt_plan (OAuth credential file at CHATGPT_PLAN_AUTH_PATH):
#   - Thesis & portfolio committee: gpt-6.2-sol (high reasoning effort)
#   - Bounded analysis (commodity_macro, weather_ag): gpt-6-luna (high reasoning effort)
# OPENAI_API_KEY is optional (only used when llm_billing_mode='api').
OPENAI_API_KEY=

# Required historical raw daily prices: Alpaca SIP, after XNYS close + 15 minutes.
# No alternative raw feed is used when access or bar validation fails.
ALPACA_API_KEY=
ALPACA_SECRET_KEY=

# Required by the 5 active gen_003 strategies (free-tier keys).
# NOAA (NCEI Access), USASpending, Drought Monitor, CFTC, yfinance, and FINRA
# require no API keys.
FRED_API_KEY=
FINNHUB_API_KEY=
USDA_NASS_API_KEY=

# Managed workers default to REPO/data/source_cache. Only successful inputs
# are cached. Override with an absolute path if needed:
# EVENTEDGE_SOURCE_CACHE_DIR=/absolute/path/to/source_cache
# EVENTEDGE_YFINANCE_CACHE_DIR=/tmp/eventedge-yfinance-cache
