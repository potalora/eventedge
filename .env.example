# Current event analysis and portfolio committee: OpenAI Responses,
# gpt-6-luna with high reasoning effort.
OPENAI_API_KEY=

# Required historical raw daily prices: Alpaca SIP, after XNYS close + 15 minutes.
# No alternative raw feed is used when access or bar validation fails.
ALPACA_API_KEY=
ALPACA_SECRET_KEY=

# Optional Clef evidence shadow through Cloudflare Workers AI.
# Token needs Workers AI Read and Edit for this account. No trade decisions
# depend on these credentials; missing access is reported separately.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Other supported LLM provider credentials (optional)
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=
XAI_API_KEY=
OPENROUTER_API_KEY=
ALPHA_VANTAGE_API_KEY=

# Required by the event strategies that use each provider.
# FMP must permit the stable House and Senate congressional feeds;
# there is no CapitolTrades scraping fallback.
FMP_API_KEY=
FRED_API_KEY=
FINNHUB_API_KEY=
REGULATIONS_API_KEY=
COURTLISTENER_TOKEN=
# Optional: direct NOAA CDO state queries only; regional weather uses public NCEI Access.
NOAA_CDO_TOKEN=
USDA_NASS_API_KEY=

# EDGAR requires a User-Agent header (no API key), format: "Name email@domain.com"
EDGAR_USER_AGENT=YourName your@email.com

# Managed workers default to REPO/data/source_cache. Only successful inputs
# are cached, for at most five minutes. Daily accepted bundles live separately
# under generation state and remain immutable on an allowed resume.
# Override with an absolute path if needed:
# EVENTEDGE_SOURCE_CACHE_DIR=/absolute/path/to/source_cache
